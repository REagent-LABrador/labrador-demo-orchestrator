{
  "registry_version": "1.0",
  "golden_program": {
    "indication": "Rheumatoid arthritis",
    "target": "IRAK4",
    "uniprot_accession": "Q9NWZ3",
    "modality": "small_molecule",
    "basis": "Frozen hackathon integration path; downstream clinical fields include explicit analyst-fixture assumptions."
  },
  "modules": [
    {
      "id": "evidence_mapper",
      "ui_stage": "biomarker",
      "order": 1,
      "repository": "REagent-LABrador/research-evidence-mapper",
      "repository_url": "https://github.com/REagent-LABrador/research-evidence-mapper.git",
      "commit": "60ae23a4275282422416b45ea5bc5041ff3e9195",
      "module_root": ".modules/research-evidence-mapper",
      "mode": "cached",
      "setup_command": ["bun", "install", "--frozen-lockfile"],
      "command": [],
      "timeout_seconds": 180,
      "input_schema": "schemas/evidence-input.schema.json",
      "output_schema": ".modules/Hypothesis_Generator/schemas/knowledge-graph.schema.json",
      "example_input": "fixtures/golden/evidence.request.json",
      "example_output": "fixtures/golden/fallbacks/evidence.json",
      "fallback_output": "fixtures/golden/fallbacks/evidence.json",
      "runtime_maturity": "UNVERIFIED",
      "result_basis": ["OBSERVED", "INFERRED"],
      "qualifiers": ["CACHED_EVIDENCE_INPUT", "VERBATIM_QUOTES", "TRUNCATED_SEARCH"]
    },
    {
      "id": "hypothesis_generator",
      "ui_stage": "hypothesis",
      "order": 2,
      "repository": "REagent-LABrador/Hypothesis_Generator",
      "repository_url": "https://github.com/REagent-LABrador/Hypothesis_Generator.git",
      "commit": "80cf2524372003b96b39106dc5487b1f98330fd3",
      "module_root": ".modules/Hypothesis_Generator",
      "mode": "auto",
      "setup_command": ["uv", "sync", "--extra", "dev"],
      "command": ["python3", "{orchestrator_root}/scripts/run_hypothesis.py", "--module-root", "{module_root}", "--input", "{input}", "--output", "{output}"],
      "timeout_seconds": 30,
      "input_schema": ".modules/Hypothesis_Generator/schemas/knowledge-graph.schema.json",
      "output_schema": ".modules/Hypothesis_Generator/schemas/hypothesis.schema.json",
      "example_input": "fixtures/golden/fallbacks/evidence.json",
      "example_output": "fixtures/golden/fallbacks/hypothesis.json",
      "fallback_output": "fixtures/golden/fallbacks/hypothesis.json",
      "runtime_maturity": "LOCAL",
      "result_basis": ["INFERRED"],
      "qualifiers": ["DETERMINISTIC_DRY_RUN", "DERIVED_FROM_CACHED_EVIDENCE"]
    },
    {
      "id": "clinical_simulation",
      "ui_stage": "recruitability",
      "order": 3,
      "repository": "REagent-LABrador/clinical_simulation",
      "repository_url": "https://github.com/REagent-LABrador/clinical_simulation.git",
      "commit": "494479bee1250d0b27ba939bbb063c6901ae3bad",
      "module_root": ".modules/clinical_simulation",
      "mode": "auto",
      "setup_command": ["bun", "install", "--frozen-lockfile"],
      "command": ["bun", "run", "simulate", "{input}", "--out", "{output}"],
      "timeout_seconds": 75,
      "input_schema": ".modules/clinical_simulation/schemas/input.schema.json",
      "output_schema": ".modules/clinical_simulation/schemas/output.schema.json",
      "example_input": ".modules/clinical_simulation/schemas/examples/irak4-ra-sourced.request.json",
      "example_output": ".modules/clinical_simulation/schemas/examples/irak4-ra-sourced.result.json",
      "fallback_output": "fixtures/golden/fallbacks/recruitability.json",
      "runtime_maturity": "UNVERIFIED",
      "result_basis": ["MODELED"],
      "qualifiers": ["SIMULATED", "ANALYST_FIXTURE_INPUT", "NOT_PROBABILITY_OF_APPROVAL"]
    },
    {
      "id": "roi_calculator",
      "ui_stage": "roi",
      "order": 4,
      "repository": "REagent-LABrador/rnpv-roi-calculator",
      "repository_url": "https://github.com/REagent-LABrador/rnpv-roi-calculator.git",
      "commit": "0a0abd5b6372969bf186d7d2cb496e898cf9703b",
      "module_root": ".modules/rnpv-roi-calculator",
      "mode": "auto",
      "setup_command": ["uv", "sync", "--locked", "--extra", "dev", "--no-editable"],
      "command": ["{module_root}/.venv/bin/rnpv-roi", "run", "--input", "{input}", "--output", "{output}"],
      "timeout_seconds": 45,
      "input_schema": ".modules/rnpv-roi-calculator/schemas/input.schema.json",
      "output_schema": ".modules/rnpv-roi-calculator/schemas/output.schema.json",
      "example_input": ".modules/rnpv-roi-calculator/examples/input.json",
      "example_output": ".modules/rnpv-roi-calculator/examples/output.json",
      "fallback_output": "fixtures/golden/fallbacks/roi.json",
      "runtime_maturity": "LOCAL",
      "result_basis": ["MODELED"],
      "qualifiers": ["SYNTHETIC", "NOT_DECISION_GRADE"]
    },
    {
      "id": "simulation",
      "ui_stage": "simulation",
      "order": 5,
      "repository": "REagent-LABrador/simulation",
      "repository_url": "https://github.com/REagent-LABrador/simulation.git",
      "commit": "15869b2c8e4ff68d13be357f72ef5d320a3920e6",
      "module_root": ".modules/simulation",
      "mode": "cached",
      "setup_command": ["python3", "-m", "pip", "install", "-r", "simulation/requirements.txt"],
      "command": ["python3", "-m", "simulation", "run", "--input", "{input}", "--output", "{output}"],
      "timeout_seconds": 75,
      "input_schema": ".modules/simulation/schemas/input.schema.json",
      "output_schema": ".modules/simulation/schemas/output.schema.json",
      "example_input": ".modules/simulation/examples/input.json",
      "example_output": ".modules/simulation/examples/output.json",
      "fallback_output": "fixtures/golden/fallbacks/simulation.json",
      "runtime_maturity": "UNVERIFIED",
      "result_basis": ["OBSERVED", "MODELED"],
      "qualifiers": ["CACHED_DOSSIER", "TRACTABILITY_NOT_ATOMISTIC", "TWO_AXES_NOT_COMBINED"]
    }
  ]
}
