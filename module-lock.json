{
  "registry_version": "1.0",
  "contracts": {
    "repository": "REagent-LABrador/platform-contracts",
    "commit": "755499b42ab65d3b01f959b11624dd4e61bdd561",
    "interpretability_schema_sha256": "ac7b27908688851b4fc3de5e3d31642a6e9d4422b422f57161f2c9ab42c3d6bb",
    "indication_thesis_schema_sha256": "ea580e9a17eb5e25818a8f089a9f0b1fa38ffc7959e2966a2c2328d124ff7b7c"
  },
  "golden_program": {
    "indication": "Rheumatoid arthritis",
    "target": "IRAK4",
    "uniprot_accession": "Q9NWZ3",
    "modality": "small_molecule",
    "basis": "Frozen hackathon integration path; downstream clinical fields include explicit analyst-fixture assumptions."
  },
  "frontend": {
    "id": "frontend",
    "repository": "REagent-LABrador/frontend",
    "repository_url": "https://github.com/REagent-LABrador/frontend.git",
    "commit": "7cbda6b4e2fd280a358dc67b86adf6b05d8c26be",
    "module_root": ".frontend",
    "static_root": ".frontend/app"
  },
  "portfolio_consumer": {
    "id": "hypothesis_highlander",
    "repository": "REagent-LABrador/hypothesis-highlander",
    "repository_url": "https://github.com/REagent-LABrador/hypothesis-highlander.git",
    "commit": "4d08ea6c38548c491f915b934a6fdd5e58f39dd6",
    "module_root": ".modules/hypothesis-highlander",
    "mode": "SERVER_NATIVE",
    "active_comparison": "HIGHLANDER_PACKET_CONSUMER",
    "setup_command": ["uv", "sync", "--extra", "dev"],
    "command": ["{module_root}/.venv/bin/python", "-m", "highlander", "compare", "--request", "{request}", "--out", "{output}"],
    "timeout_seconds": 240,
    "adapter_version": "packet-adapters.v1",
    "producer_contracts": {
      "evidence_mapper": {
        "module_id": "research-evidence-mapper",
        "native_schema_id": "EvidenceGraph",
        "native_schema_version": "1.1"
      },
      "hypothesis_generator": {
        "module_id": "hypothesis-generator",
        "native_schema_id": "https://labrador.dev/schemas/headless-output.schema.json",
        "native_schema_version": "unversioned"
      },
      "clinical_simulation": {
        "module_id": "trial-recruitment-forecaster",
        "native_schema_id": "https://github.com/REagent-LABrador/clinical_simulation/schemas/output.schema.json",
        "native_schema_version": "1.0.0"
      },
      "roi_calculator": {
        "module_id": "therapeutic-program-economics",
        "native_schema_id": "urn:reagent-labrador:rnpv_roi_calculator:output:1.0.0",
        "native_schema_version": "1.0.0"
      },
      "simulation": {
        "module_id": "small-molecule-tractability-review",
        "native_schema_id": "https://github.com/REagent-LABrador/simulation/schema/output.schema.json",
        "native_schema_version": "1.0.0"
      }
    },
    "objective_policy": {
      "policyId": "labrador.scientific-portfolio.v1",
      "objectives": [
        {"objectiveId": "support", "direction": "MAX"},
        {"objectiveId": "novelty", "direction": "MAX"},
        {"objectiveId": "testability", "direction": "MAX"},
        {"objectiveId": "contradiction_risk", "direction": "MIN"},
        {"objectiveId": "recruitability", "direction": "MAX"},
        {"objectiveId": "roi", "direction": "MAX"}
      ]
    }
  },
  "modules": [
    {
      "id": "evidence_mapper",
      "ui_stage": "biomarker",
      "order": 1,
      "repository": "REagent-LABrador/research-evidence-mapper",
      "repository_url": "https://github.com/REagent-LABrador/research-evidence-mapper.git",
      "commit": "551a5a8c4c7ff4143c21dab2e37519ac9f482c04",
      "module_root": ".modules/research-evidence-mapper",
      "mode": "replay",
      "setup_command": ["bun", "install", "--frozen-lockfile"],
      "command": ["python3", "{orchestrator_root}/scripts/run_evidence_replay.py", "--module-root", "{module_root}", "--recorded-input", "{orchestrator_root}/fixtures/golden/evidence.request.json", "--recorded-output", "{orchestrator_root}/fixtures/golden/fallbacks/evidence.json", "--input", "{input}", "--output", "{output}"],
      "timeout_seconds": 1200,
      "input_schema": "schemas/evidence-input.schema.json",
      "output_schema": ".modules/research-evidence-mapper/schema/graph.schema.json",
      "example_input": "fixtures/golden/evidence.request.json",
      "example_output": "fixtures/golden/fallbacks/evidence.json",
      "fallback_output": "fixtures/golden/fallbacks/evidence.json",
      "runtime_maturity": "LOCAL",
      "result_basis": ["OBSERVED", "INFERRED"],
      "qualifiers": ["RECORDED_SEARCH_REPLAY", "NO_NEW_LITERATURE_SEARCH", "VERBATIM_QUOTES", "TRUNCATED_SEARCH"]
    },
    {
      "id": "hypothesis_generator",
      "ui_stage": "hypothesis",
      "order": 2,
      "repository": "REagent-LABrador/Hypothesis_Generator",
      "repository_url": "https://github.com/REagent-LABrador/Hypothesis_Generator.git",
      "commit": "02ea1441412c556fdaf80a1264bbe605d0133ceb",
      "module_root": ".modules/Hypothesis_Generator",
      "mode": "auto",
      "setup_command": ["uv", "sync", "--extra", "dev"],
      "command": ["python3", "{orchestrator_root}/scripts/run_hypothesis.py", "--module-root", "{module_root}", "--input", "{input}", "--output", "{output}"],
      "timeout_seconds": 1200,
      "input_schema": ".modules/Hypothesis_Generator/schemas/knowledge-graph.schema.json",
      "output_schema": ".modules/Hypothesis_Generator/schemas/cards.schema.json",
      "example_input": "fixtures/golden/fallbacks/evidence.json",
      "example_output": "fixtures/golden/fallbacks/hypothesis.json",
      "fallback_output": "fixtures/golden/fallbacks/hypothesis.json",
      "runtime_maturity": "LOCAL",
      "result_basis": ["INFERRED"],
      "qualifiers": ["DETERMINISTIC_DRY_RUN", "STRUCTURAL_CANDIDATE_SLATE", "DERIVED_FROM_RECORDED_EVIDENCE"]
    },
    {
      "id": "clinical_simulation",
      "ui_stage": "recruitability",
      "order": 3,
      "repository": "REagent-LABrador/clinical_simulation",
      "repository_url": "https://github.com/REagent-LABrador/clinical_simulation.git",
      "commit": "1d417b43ee8cb3b20a0769eedfc8e97474d65e30",
      "module_root": ".modules/clinical_simulation",
      "mode": "replay",
      "setup_command": ["bun", "install", "--frozen-lockfile"],
      "command": ["python3", "{orchestrator_root}/scripts/run_clinical_replay.py", "--recorded-output", "{orchestrator_root}/fixtures/golden/fallbacks/recruitability.json", "--input", "{input}", "--output", "{output}"],
      "timeout_seconds": 600,
      "input_schema": ".modules/clinical_simulation/schemas/input.schema.json",
      "output_schema": ".modules/clinical_simulation/schemas/output.schema.json",
      "example_input": ".modules/clinical_simulation/schemas/examples/irak4-ra-sourced.request.json",
      "example_output": ".modules/clinical_simulation/schemas/examples/irak4-ra-sourced.result.json",
      "fallback_output": "fixtures/golden/fallbacks/recruitability.json",
      "runtime_maturity": "LOCAL",
      "result_basis": ["MODELED"],
      "qualifiers": ["MODELED_FORECAST", "RECORDED_RESULT_REPLAY", "SHARED_RA_ANALYST_FRAME", "NOT_CANDIDATE_SPECIFIC", "NOT_PROBABILITY_OF_APPROVAL"]
    },
    {
      "id": "roi_calculator",
      "ui_stage": "roi",
      "order": 4,
      "repository": "REagent-LABrador/rnpv-roi-calculator",
      "repository_url": "https://github.com/REagent-LABrador/rnpv-roi-calculator.git",
      "commit": "0a0abd5b6372969bf186d7d2cb496e898cf9703b",
      "module_root": ".modules/rnpv-roi-calculator",
      "mode": "auto",
      "setup_command": ["uv", "sync", "--locked", "--extra", "dev", "--no-editable"],
      "command": ["{module_root}/.venv/bin/rnpv-roi", "run", "--input", "{input}", "--output", "{output}"],
      "timeout_seconds": 240,
      "input_schema": ".modules/rnpv-roi-calculator/schemas/input.schema.json",
      "output_schema": ".modules/rnpv-roi-calculator/schemas/output.schema.json",
      "example_input": ".modules/rnpv-roi-calculator/examples/input.json",
      "example_output": ".modules/rnpv-roi-calculator/examples/output.json",
      "fallback_output": "fixtures/golden/fallbacks/roi.json",
      "runtime_maturity": "LOCAL",
      "result_basis": ["MODELED"],
      "qualifiers": ["SYNTHETIC", "NOT_DECISION_GRADE", "SHARED_RA_ANALYST_FRAME", "NOT_CANDIDATE_SPECIFIC"]
    },
    {
      "id": "simulation",
      "ui_stage": "simulation",
      "order": 5,
      "repository": "REagent-LABrador/simulation",
      "repository_url": "https://github.com/REagent-LABrador/simulation.git",
      "commit": "63ed6e560e7c0e66e51085e9140fdcc28c7ca64d",
      "module_root": ".modules/simulation",
      "mode": "replay",
      "setup_command": ["python3", "-m", "pip", "install", "-r", "simulation/requirements.txt"],
      "command": ["python3", "{orchestrator_root}/scripts/run_simulation_replay.py", "--module-root", "{module_root}", "--recorded-output", "{orchestrator_root}/fixtures/golden/fallbacks/simulation.json", "--input", "{input}", "--output", "{output}"],
      "timeout_seconds": 5400,
      "input_schema": ".modules/simulation/schemas/input.schema.json",
      "output_schema": ".modules/simulation/schemas/output.schema.json",
      "example_input": ".modules/simulation/examples/input.json",
      "example_output": ".modules/simulation/examples/output.json",
      "fallback_output": "fixtures/golden/fallbacks/simulation.json",
      "runtime_maturity": "LOCAL",
      "result_basis": ["OBSERVED", "MODELED"],
      "qualifiers": ["LOCAL_CACHE_RESOLVER", "CACHED_DOSSIER", "SCIENTIFIC_VALUES_FROM_BUNDLED_CACHE", "SHARED_RA_ANALYST_FRAME", "NOT_CANDIDATE_SPECIFIC", "TRACTABILITY_NOT_ATOMISTIC", "TWO_AXES_NOT_COMBINED"]
    }
  ]
}
